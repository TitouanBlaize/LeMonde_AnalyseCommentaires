# Compte abonne Le Monde (articles payants en entier + espace des contributions)
EMAIL_MONDE="prenom.nom@exemple.fr"
PASSWORD_MONDE="votre-mot-de-passe"

# Cle API Mistral (https://console.mistral.ai/)
MISTRAL_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# Optionnel : modele et repli (par defaut ministral-8b-latest, accessible en offre gratuite)
# MISTRAL_MODEL="mistral-small-latest"
# MISTRAL_FALLBACK_MODELS="ministral-8b-latest,open-mistral-nemo"

# Optionnel : reglages du digest
# NB_ARTICLES=10
# MAX_ARTICLE_CHARS=12000
# MAX_COMMENTS=120
# MAX_COMMENT_CHARS=15000
# SELENIUM_HEADLESS=true
# SELENIUM_BROWSER=firefox
